<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resorce\app.ico</ApplicationIcon>
    <AssemblyTitle>Мармеладная зебра — меню ресторана</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
    <Resource Include="Resorce\app.ico;Resorce\logo.jpg" />
    <Content Include="connection.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
