<Window x:Class="WPF_PR17_restaurant_Zaytsev.MainPage.DishWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Width="545" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}" Closing="Window_Closing">
    <StackPanel x:Name="Form" Margin="24">
        <Border Background="{StaticResource BrandBlue}" Padding="12" CornerRadius="7" Margin="0,0,0,12">
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       FontSize="21" FontWeight="Bold" />
        </Border>
        <Label Content="Название блюда" Target="{Binding ElementName=NameBox}" />
        <TextBox x:Name="NameBox" MaxLength="100" />
        <UniformGrid Columns="2" Margin="0,9,0,0">
            <StackPanel Margin="0,0,8,9">
                <Label Content="Категория" Target="{Binding ElementName=CategoryBox}" />
                <ComboBox x:Name="CategoryBox" DisplayMemberPath="Name" SelectedValuePath="Id" />
            </StackPanel>
            <StackPanel Margin="8,0,0,9">
                <Label Content="Кухня" Target="{Binding ElementName=CuisineBox}" />
                <ComboBox x:Name="CuisineBox" DisplayMemberPath="Name" SelectedValuePath="Id" />
            </StackPanel>
            <StackPanel Margin="0,0,8,9">
                <Label Content="Порция" Target="{Binding ElementName=SizeBox}" />
                <ComboBox x:Name="SizeBox" DisplayMemberPath="Name" SelectedValuePath="Id" />
            </StackPanel>
            <StackPanel Margin="8,0,0,9">
                <Label Content="Цена, ₽" Target="{Binding ElementName=PriceBox}" />
                <TextBox x:Name="PriceBox" MaxLength="10" />
            </StackPanel>
        </UniformGrid>
        <Label Content="Описание" Target="{Binding ElementName=DescriptionBox}" />
        <TextBox x:Name="DescriptionBox" MaxLength="500" Height="83" AcceptsReturn="True"
                 TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Accent}" TextWrapping="Wrap"
                   Margin="0,9,0,0" MinHeight="24" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Отмена" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
            <Button Content="Сохранить" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
