<Window x:Class="WPF_PR17_restaurant_Zaytsev.MainPage.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Мармеладная зебра — меню ресторана | ПР 17" Width="1050" Height="740"
        MinWidth="890" MinHeight="580" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid x:Name="Workspace">
        <Grid.RowDefinitions>
            <RowDefinition Height="132" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource BrandBlue}" Padding="25,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="White" Padding="4" CornerRadius="8">
                    <Image Width="92" Height="92" Source="/WPF_PR17_restaurant_Zaytsev;component/Resorce/logo.jpg" />
                </Border>
                <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                    <TextBlock Text="РЕСТОРАН  /  ПРАКТИЧЕСКАЯ РАБОТА 17" FontSize="12" />
                    <TextBlock Text="Мармеладная зебра" FontSize="34" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Button x:Name="SessionButton" Content="Войти" Click="Session_Click"
                            Style="{StaticResource SecondaryButton}" />
                    <TextBlock x:Name="SessionText" Text="Гостевой режим" Margin="0,7,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="25,16,25,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="90" />
            </Grid.RowDefinitions>
            <TextBlock Text="Меню ресторана" FontSize="24" FontWeight="Bold" Margin="0,0,0,11" />
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                    <Label Content="Поиск" Target="{Binding ElementName=SearchBox}" />
                    <TextBox x:Name="SearchBox" TextChanged="Search_Changed" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <Label Content="Категория" Target="{Binding ElementName=CategoryFilter}" />
                    <ComboBox x:Name="CategoryFilter" DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectionChanged="Filter_Changed" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <Label Content="Кухня" Target="{Binding ElementName=CuisineFilter}" />
                    <ComboBox x:Name="CuisineFilter" DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectionChanged="Filter_Changed" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <Label Content="Порция" Target="{Binding ElementName=SizeFilter}" />
                    <ComboBox x:Name="SizeFilter" DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectionChanged="Filter_Changed" />
                </StackPanel>
                <Button Grid.Column="4" Content="Сбросить" Click="Reset_Click" VerticalAlignment="Bottom"
                        Style="{StaticResource SecondaryButton}" />
            </Grid>
            <DockPanel Grid.Row="2" Margin="0,0,0,12" LastChildFill="False">
                <Button x:Name="AddButton" Content="Добавить блюдо" Click="Add_Click" IsEnabled="False" Margin="0,0,8,0" />
                <Button x:Name="EditButton" Content="Редактировать" Click="Edit_Click" IsEnabled="False"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                <Button x:Name="DeleteButton" Content="Удалить" Click="Delete_Click" IsEnabled="False"
                        Style="{StaticResource DangerButton}" />
                <Button DockPanel.Dock="Right" Content="Обновить" Click="Refresh_Click"
                        Style="{StaticResource SecondaryButton}" />
            </DockPanel>
            <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="8" ClipToBounds="True">
                <Grid>
                    <DataGrid x:Name="DishesGrid" SelectionChanged="Dish_Changed"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Блюдо" Binding="{Binding Name}" Width="*" MinWidth="220" />
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category.Name}" Width="135" />
                            <DataGridTextColumn Header="Кухня" Binding="{Binding Cuisine.Name}" Width="135" />
                            <DataGridTextColumn Header="Порция" Binding="{Binding ServingSize.Name}" Width="135" />
                            <DataGridTextColumn Header="Цена" Binding="{Binding PriceText}" SortMemberPath="Price" Width="125" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="EmptyText" Visibility="Collapsed" IsHitTestVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Grid.Row="4" Background="{StaticResource BrandYellow}" Padding="14,8"
                    Margin="0,11,0,0" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="О БЛЮДЕ" FontSize="11" FontWeight="Bold" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="48" Margin="0,4,0,0">
                        <TextBlock x:Name="DescriptionText" Text="Выберите блюдо в меню." TextWrapping="Wrap" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="25,0" LastChildFill="True">
            <TextBlock x:Name="CountText" Text="Загрузка меню…" FontSize="12" VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Right" Text="WPF  /  MS SQL Server" FontSize="12" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Margin="16,0" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
