<Window x:Class="WPF_PR15_Mebel_ZaytsevVI.MainPage.CatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Мебель для кухни — ZaytsevVI | ПР 15, вариант 4"
        Width="1280" Height="850" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="105"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
        <Border Background="#193B3A" Padding="28,18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ПРАКТИЧЕСКАЯ РАБОТА 15   /   ВАРИАНТ 04" Foreground="#AFCAC3" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="Мебель для кухни" Foreground="White" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="КАТАЛОГ МЕБЕЛИ" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Text="ZaytsevVI" Foreground="#AFCAC3" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Image Source="pack://application:,,,/WPF_PR15_Mebel_ZaytsevVI;component/Resorce/logo.png" Width="54" Height="54" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="28,22,28,0" x:Name="Workspace">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/><RowDefinition Height="90"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/><RowDefinition Height="100"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="18,10" Margin="0,0,12,0">
                    <StackPanel><TextBlock Text="Товаров в каталоге" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="TotalProductsText" Text="—" FontSize="27" FontWeight="SemiBold"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="18,10" Margin="0,0,12,0">
                    <StackPanel><TextBlock Text="Категорий мебели" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="TotalCategoriesText" Text="—" FontSize="27" FontWeight="SemiBold"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#E8EFE6" CornerRadius="9" Padding="18,10">
                    <StackPanel><TextBlock Text="Единиц на складе" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="TotalStockText" Text="—" FontSize="27" FontWeight="SemiBold"/></StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="1" Margin="0,18,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0"><TextBlock Text="ПОИСК ПО НАЗВАНИЮ, АРТИКУЛУ И ОПИСАНИЮ" Style="{StaticResource FieldLabel}" FontSize="10"/><TextBox x:Name="SearchBox" TextChanged="Filter_Changed" ToolTip="Начните вводить название, артикул или описание"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="КАТЕГОРИЯ" Style="{StaticResource FieldLabel}" FontSize="10"/><ComboBox x:Name="CategoryFilter" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="SelectionFilter_Changed"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="МАТЕРИАЛ" Style="{StaticResource FieldLabel}" FontSize="10"/><ComboBox x:Name="MaterialFilter" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="SelectionFilter_Changed"/></StackPanel>
                <StackPanel Grid.Column="3"><TextBlock Text="СОРТИРОВКА" Style="{StaticResource FieldLabel}" FontSize="10"/><ComboBox x:Name="SortBox" SelectedIndex="0" SelectionChanged="SelectionFilter_Changed"><ComboBoxItem Content="Сначала новые"/><ComboBoxItem Content="Цена: по возрастанию"/><ComboBoxItem Content="Цена: по убыванию"/><ComboBoxItem Content="По названию"/></ComboBox></StackPanel>
            </Grid>
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="＋  Добавить товар" Click="Add_Click" Margin="0,0,8,0"/>
                    <Button x:Name="EditButton" Content="Изменить" Click="Edit_Click" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="0,0,8,0"/>
                    <Button x:Name="DeleteButton" Content="Удалить" Click="Delete_Click" Style="{StaticResource DangerButton}" IsEnabled="False"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Сбросить фильтры" Click="Reset_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="Обновить" Click="Refresh_Click" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
                <Grid>
                    <DataGrid x:Name="ProductsGrid" SelectionChanged="ProductsGrid_SelectionChanged" MouseDoubleClick="ProductsGrid_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="АРТИКУЛ" Binding="{Binding Article}" Width="105"/>
                            <DataGridTemplateColumn Header="ТОВАР / МАТЕРИАЛ" Width="*" MinWidth="200">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding MaterialName}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="КАТЕГОРИЯ" Binding="{Binding CategoryName}" Width="155"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                            <DataGridTextColumn Header="Ш × Г × В, ММ" Binding="{Binding DimensionsText}" Width="173"/>
                            <DataGridTextColumn Header="ЦЕНА" Binding="{Binding PriceText}" Width="136"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                            <DataGridTemplateColumn Header="НАЛИЧИЕ" Width="134"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Padding="8,5" CornerRadius="5" HorizontalAlignment="Left"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#E8F3EB"/><Style.Triggers><DataTrigger Binding="{Binding IsAvailable}" Value="False"><Setter Property="Background" Value="#F8E9E6"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding StockText}" FontSize="12"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="EmptyText" Text="В каталоге пока нет товаров. Добавьте первый товар." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                </Grid>
            </Border>
            <Border Grid.Row="4" Margin="0,12,0,12" Padding="14,10" Background="#EAF0EB" CornerRadius="8">
                <StackPanel><TextBlock Text="ОПИСАНИЕ ВЫБРАННОГО ТОВАРА" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="DescriptionText" Text="Выберите товар, чтобы увидеть описание. Двойной щелчок открывает редактирование." TextWrapping="Wrap" MaxHeight="48" Margin="0,5,0,0"/></StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="28,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="CounterText" Text="Загрузка…" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}"/>
            <TextBlock x:Name="StatusText" Grid.Column="1" Margin="16,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}"/>
            <TextBlock Grid.Column="2" Text="MS SQL Server  •  WPF" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}"/>
        </Grid>
    </Grid>
</Window>
