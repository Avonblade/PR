<Window x:Class="WPF_PR15_Mebel_ZaytsevVI.MainPage.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Товар — мебель для кухни" Width="720" Height="820" MinWidth="650" MinHeight="640"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Padding="24,18" Background="#193B3A">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="МЕБЕЛЬ ДЛЯ КУХНИ" Foreground="#AFCAC3" FontSize="11"/><TextBlock x:Name="HeadingText" Text="Новый товар" FontSize="25" FontWeight="SemiBold" Foreground="White" Margin="0,5,0,0"/></StackPanel>
                <Image Source="pack://application:,,,/WPF_PR15_Mebel_ZaytsevVI;component/Resorce/logo.png" Grid.Column="1" Width="52" Height="52"/>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="FormPanel" Margin="24,20,24,12">
                <TextBlock x:Name="IdText" Text="Номер товара присваивается при сохранении" Foreground="{StaticResource Muted}" Margin="0,0,0,16" FontSize="12"/>
                <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,14,0"><TextBlock Text="Артикул *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ArticleBox" MaxLength="30"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="Название товара *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NameBox" MaxLength="120"/></StackPanel>
                </Grid>
                <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,14,0"><TextBlock Text="Категория *" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="CategoryBox" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="Материал *" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="MaterialBox" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel>
                </Grid>
                <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,14,0"><TextBlock Text="Цена, ₽ *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PriceBox" MaxLength="16" ToolTip="Неотрицательная цена, до двух знаков после запятой"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="Количество на складе, шт. *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="StockBox" MaxLength="7"/></StackPanel>
                </Grid>
                <Border Background="#EAF0EB" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <StackPanel><TextBlock Text="Габариты в миллиметрах" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="Ширина *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="WidthBox" MaxLength="5"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Глубина *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DepthBox" MaxLength="5"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Высота *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="HeightBox" MaxLength="5"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock Text="Описание" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" Height="105" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" MaxLength="2000"/>
                <TextBlock Text="* Обязательные поля. Размеры: 1–10 000 мм. Цена и остаток не могут быть отрицательными." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,15">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="SaveStatusText" Text="Изменения сохраняются в SQL Server" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Content="Отмена" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,10,0"/>
                    <Button x:Name="SaveButton" Content="Сохранить товар" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
