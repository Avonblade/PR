<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
  </ItemGroup>

  <PropertyGroup>
    <ApplicationIcon>Resorce\app.ico</ApplicationIcon>
    <AssemblyTitle>Кухня — каталог мебели | Зайцев В. И.</AssemblyTitle>
    <Description>Практическая работа 15, вариант 4 — мебель для кухни</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Resorce\app.ico" />
    <Resource Include="Resorce\logo.png" />
    <Content Include="connection.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
