<Window x:Class="WPF_PR19_fitness_Zaytsev.MainPage.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="Вход в систему"
        Width="425" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FocusManager.FocusedElement="{Binding ElementName=LoginBox}"
        Closing="Window_Closing">
    <StackPanel x:Name="Form" Margin="24">
        <Border Padding="12" Background="{StaticResource BrandLight}" CornerRadius="7" Margin="0,0,0,12">
            <TextBlock Text="Фитнес-учёт" FontSize="21" FontWeight="Bold" />
        </Border>
        <Label Content="Логин" Target="{Binding ElementName=LoginBox}" />
        <TextBox x:Name="LoginBox" MaxLength="50" />
        <Label Content="Пароль" Target="{Binding ElementName=PasswordBox}" Margin="0,9,0,0" />
        <PasswordBox x:Name="PasswordBox" MaxLength="128" />
        <TextBlock x:Name="ErrorText" Foreground="#A92C3E" TextWrapping="Wrap"
                   Margin="0,10,0,0" MinHeight="22" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Отмена" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
            <Button Content="Войти" IsDefault="True" Click="Login_Click" />
        </StackPanel>
    </StackPanel>
</Window>
