<Window x:Class="WPF_PR19_fitness_Zaytsev.MainPage.WorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Фитнес-учёт — ПР 19" Width="1260" Height="790" MinWidth="920" MinHeight="610"
        WindowStartupLocation="CenterScreen" Language="ru-RU" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition/></Grid.RowDefinitions>
        <Border Background="{StaticResource BrandNavy}" Padding="24,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Выход" Click="SignOut_Click" VerticalAlignment="Center"
                        Style="{StaticResource SecondaryButton}" />
                <StackPanel DockPanel.Dock="Right" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="UserText" Foreground="White" FontWeight="SemiBold" TextAlignment="Right"/>
                    <TextBlock x:Name="RoleText" Foreground="#BCE4E1" FontSize="12" TextAlignment="Right"/>
                    <TextBlock x:Name="ClockText" Foreground="#D9E4F4" FontSize="11" TextAlignment="Right" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="КЛУБ  /  ПРАКТИЧЕСКАЯ РАБОТА 19" Foreground="#BCE4E1" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="Фитнес-учёт" Foreground="White" FontSize="28" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" x:Name="Workspace" Margin="24,16,24,10">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="35"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,12">
                <Button Content="Расписание" Click="Schedule_Click" Margin="0,0,8,6"/>
                <Button x:Name="EntryButton" Content="Вход в клуб" Click="Entry_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6"/>
                <Button x:Name="ExitButton" Content="Выход из клуба" Click="Exit_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6"/>
                <Button x:Name="HistoryButton" Content="История посещений" Click="History_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6"/>
                <Button x:Name="EmployeesButton" Content="Сотрудники" Click="Employees_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6"/>
                <Button x:Name="RoomsButton" Content="Залы" Click="Rooms_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6"/>
                <Button x:Name="ReportsButton" Content="Отчёты" Click="Reports_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6"/>
            </WrapPanel>
            <Border x:Name="CoachPanel" Grid.Row="1" Visibility="Collapsed" CornerRadius="9" Background="{StaticResource BrandLight}" Padding="18" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Рабочее место тренера" FontWeight="SemiBold" FontSize="23"/>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="Откройте расписание и выберите свою тренировку, чтобы просмотреть участников и отметить присутствие."/>
                </StackPanel>
            </Border>
            <Grid x:Name="ClientPanel" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Обновить" Click="Refresh_Click" Style="{StaticResource SecondaryButton}"/>
                    <StackPanel>
                        <TextBlock Text="Клиенты клуба" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="Карточки клиентов, сроки абонементов и последние посещения." Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.2*"/><ColumnDefinition/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <Label Content="ФИО, телефон, карта, тип" Target="{Binding ElementName=SearchBox}"/>
                        <TextBox x:Name="SearchBox" TextChanged="Search_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <Label Content="Статус клиента" Target="{Binding ElementName=StatusFilter}"/>
                        <ComboBox x:Name="StatusFilter" SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <Label Content="Абонемент" Target="{Binding ElementName=TypeFilter}"/>
                        <ComboBox x:Name="TypeFilter" SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <Label Content="Срок" Target="{Binding ElementName=ExpiryFilter}"/>
                        <ComboBox x:Name="ExpiryFilter" SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="0,0,8,0">
                        <Label Content="Остаток посещений" Target="{Binding ElementName=BalanceFilter}"/>
                        <ComboBox x:Name="BalanceFilter" SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                    <Button Grid.Column="5" Content="Сбросить фильтры" Click="Reset_Click" VerticalAlignment="Bottom"
                            Style="{StaticResource SecondaryButton}"/>
                </Grid>
                <WrapPanel Grid.Row="2" Margin="0,0,0,7">
                    <Button x:Name="AddButton" Content="Добавить клиента" Click="Add_Click" Margin="0,0,8,5"/>
                    <Button x:Name="EditButton" Content="Редактировать" Click="Edit_Click" Margin="0,0,8,5" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="BlockButton" Content="Заблокировать" Click="Block_Click" Margin="0,0,8,5" Style="{StaticResource DangerButton}"/>
                    <Button x:Name="SaleButton" Content="Оформить абонемент" Click="Sale_Click" Margin="0,0,8,5" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="PlansButton" Content="Абонементы" Click="Plans_Click" Margin="0,0,8,5" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="FreezeButton" Content="Заморозить" Click="Freeze_Click" Margin="0,0,8,5" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="ThawButton" Content="Разморозить" Click="Thaw_Click" Margin="0,0,8,5" Style="{StaticResource SecondaryButton}"/>
                </WrapPanel>
                <Border Grid.Row="3" CornerRadius="8" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="White" ClipToBounds="True">
                    <Grid>
                        <DataGrid x:Name="ClientsGrid" SelectionChanged="Client_Changed">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                            <Setter Property="Background" Value="#FCE5E9"/>
                                            <Setter Property="Foreground" Value="#842539"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ФИО" Binding="{Binding Name}" Width="*" MinWidth="160"/>
                                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="145"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="139"/>
                                <DataGridTextColumn Header="Абонемент" Binding="{Binding PlanTypeText}" Width="128"/>
                                <DataGridTextColumn Header="Состояние" Binding="{Binding PlanStateText}" Width="130"/>
                                <DataGridTemplateColumn Header="Действует до" Width="118" SortMemberPath="EndsOn">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="6,3" CornerRadius="4" HorizontalAlignment="Left">
                                                <Border.Style><Style TargetType="Border"><Style.Triggers>
                                                    <DataTrigger Binding="{Binding Expiring}" Value="True"><Setter Property="Background" Value="#FFD5B0"/></DataTrigger>
                                                </Style.Triggers></Style></Border.Style>
                                                <TextBlock Text="{Binding EndsOn, StringFormat=dd.MM.yyyy, TargetNullValue=—}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Остаток" Width="109" SortMemberPath="Remaining">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="6,3" CornerRadius="4" HorizontalAlignment="Left">
                                                <Border.Style><Style TargetType="Border"><Style.Triggers>
                                                    <DataTrigger Binding="{Binding LowBalance}" Value="True"><Setter Property="Background" Value="#FFF0A5"/></DataTrigger>
                                                </Style.Triggers></Style></Border.Style>
                                                <TextBlock Text="{Binding RemainingText}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Последний вход" Binding="{Binding LastVisit, StringFormat=dd.MM.yyyy HH:mm, TargetNullValue=—}" Width="143"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="EmptyText" Visibility="Collapsed" IsHitTestVisible="False"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                    </Grid>
                </Border>
                <WrapPanel Grid.Row="4" Margin="0,9,0,0">
                    <Border Background="#FFF0A5" Padding="6,3" CornerRadius="4" Margin="0,0,8,0"><TextBlock Text="Осталось до 3"/></Border>
                    <Border Background="#FFD5B0" Padding="6,3" CornerRadius="4" Margin="0,0,8,0"><TextBlock Text="Истекает за 7 дней"/></Border>
                    <Border Background="#FCE5E9" Padding="6,3" CornerRadius="4"><TextBlock Text="Клиент заблокирован"/></Border>
                </WrapPanel>
            </Grid>
            <DockPanel Grid.Row="2" Margin="0,6,0,0">
                <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12"/>
                <TextBlock DockPanel.Dock="Right" Text="WPF  /  MS SQL Server" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="13,0" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" FontSize="12"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
