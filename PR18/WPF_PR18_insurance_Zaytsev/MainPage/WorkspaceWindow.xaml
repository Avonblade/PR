<Window x:Class="WPF_PR18_insurance_Zaytsev.MainPage.WorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Страховая медицинская компания — ПР 18" Width="1240" Height="760"
        MinWidth="880" MinHeight="570" WindowStartupLocation="CenterScreen"
        Language="ru-RU" Loaded="Window_Loaded">
    <Grid x:Name="Workspace">
        <Grid.RowDefinitions>
            <RowDefinition Height="82" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource BrandNavy}" Padding="22,13">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Выйти" Click="SignOut_Click"
                        Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Margin="0,0,18,0" VerticalAlignment="Center">
                    <TextBlock x:Name="UserText" Foreground="White" FontWeight="SemiBold" TextAlignment="Right" />
                    <TextBlock x:Name="RoleText" Foreground="#B8DFD9" FontSize="12" TextAlignment="Right" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="СМК  /  ПРАКТИЧЕСКАЯ РАБОТА 18" Foreground="#B8DFD9" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="Медицинское страхование" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,17">
                    <TextBlock DockPanel.Dock="Top" Text="РАЗДЕЛЫ УЧЁТА" Foreground="{StaticResource Muted}"
                               FontSize="11" FontWeight="SemiBold" Margin="8,0,0,10" />
                    <ListBox x:Name="Navigation" DisplayMemberPath="Title" BorderThickness="0"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="Navigation_Changed">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="9,8" />
                                <Setter Property="Margin" Value="0,0,0,3" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Tile" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Tile" Property="Background" Value="#F1F8F7" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Tile" Property="Background" Value="{StaticResource BrandLight}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="22,18,22,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="38" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,12">
                    <TextBlock x:Name="SectionTitle" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock x:Name="SectionDescription" Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <DockPanel Grid.Row="1" Margin="0,0,0,11">
                    <Button DockPanel.Dock="Right" Content="Обновить" Click="Refresh_Click"
                            Style="{StaticResource SecondaryButton}" Margin="9,0,0,0" />
                    <Grid>
                        <TextBox x:Name="SearchBox" TextChanged="Search_Changed"
                                 AutomationProperties.Name="Поиск по разделу" ToolTip="Поиск по всем видимым столбцам" />
                        <TextBlock x:Name="SearchPrompt" Text="Поиск по разделу" Foreground="{StaticResource Muted}"
                                   IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Margin="11,0,0,0" />
                    </Grid>
                </DockPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,11">
                    <Button x:Name="AddButton" Content="Добавить" Click="Add_Click" Margin="0,0,8,0" />
                    <Button x:Name="EditButton" Content="Редактировать" Click="Edit_Click"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                    <Button x:Name="DeleteButton" Content="Удалить" Click="Delete_Click"
                            Style="{StaticResource DangerButton}" />
                    <TextBlock x:Name="ReadOnlyText" Text="Просмотр данных" Foreground="{StaticResource Muted}"
                               VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
                <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="8" ClipToBounds="True">
                    <Grid>
                        <DataGrid x:Name="RecordsGrid" SelectionChanged="Row_Changed"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                        <TextBlock x:Name="EmptyText" Foreground="{StaticResource Muted}" IsHitTestVisible="False"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                </Border>
                <DockPanel Grid.Row="4" Margin="0,8,0,0">
                    <TextBlock x:Name="CountText" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Text="WPF  /  MS SQL Server" FontSize="12"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource Muted}"
                               Margin="14,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
