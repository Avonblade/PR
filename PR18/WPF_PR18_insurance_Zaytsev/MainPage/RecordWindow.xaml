<Window x:Class="WPF_PR18_insurance_Zaytsev.MainPage.RecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Width="690" SizeToContent="Height" MaxHeight="680" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <Grid x:Name="Form" Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource BrandLight}" Padding="13,10" CornerRadius="7" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="SectionText" FontSize="11" Foreground="{StaticResource Muted}" />
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0" />
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="FieldsPanel" Margin="0,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
            </Grid>
        </ScrollViewer>
        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#A92C3E" TextWrapping="Wrap"
                   MinHeight="22" Margin="0,9,0,0" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Отмена" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
            <Button Content="Сохранить" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
