<Window x:Class="WPF_PR20_studio_Zaytsev.MainPage.WorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="ФотоСтудия" Width="1330" Height="790"
        MinWidth="960" MinHeight="620" Language="ru-RU" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition/></Grid.RowDefinitions>
        <Border Background="{StaticResource BrandNavy}" Padding="24,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Выход" Click="SignOut_Click" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}"/>
                <StackPanel DockPanel.Dock="Right" Margin="0,0,18,0" VerticalAlignment="Center">
                    <TextBlock x:Name="Person" Foreground="White" FontWeight="SemiBold" TextAlignment="Right"/>
                    <TextBlock x:Name="Role" Foreground="#E7D9F1" FontSize="12" TextAlignment="Right"/>
                    <TextBlock x:Name="Clock" Foreground="#E7D9F1" FontSize="11" TextAlignment="Right" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock Text="ФотоСтудия" Foreground="White" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="24,16,24,12" x:Name="Workspace">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="Обновить" Click="Refresh_Click" Style="{StaticResource SecondaryButton}"/>
                <TextBlock Text="Календарь бронирований" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <WrapPanel Grid.Row="1" Margin="0,0,0,7">
                <Button x:Name="NewButton" Content="Создать бронь" Click="New_Click" Margin="0,0,8,6"/>
                <Button x:Name="MoveButton" Content="Перенести" Click="Move_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6"/>
                <Button x:Name="CancelButton" Content="Отменить" Click="Cancel_Click" Style="{StaticResource DangerButton}" Margin="0,0,8,6"/>
                <Button x:Name="CardButton" Content="Карточка съёмки" Click="Card_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,16,6"/>
                <Button x:Name="ClientButton" Content="Клиенты" Click="Clients_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6"/>
                <Button Content="Залы" Click="Rooms_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6"/>
                <Button Content="Реквизит" Click="Props_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6"/>
                <Button x:Name="StaffButton" Content="Сотрудники" Click="Staff_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6"/>
                <Button x:Name="ReportButton" Content="Отчёты" Click="Reports_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6"/>
            </WrapPanel>
            <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                <StackPanel Width="233" Margin="0,0,8,4"><Label Content="Клиент, зал, фотограф, номер или тип" Target="{Binding ElementName=SearchBox}"/><TextBox x:Name="SearchBox" TextChanged="Filter_Changed"/></StackPanel>
                <StackPanel Width="137" Margin="0,0,8,4"><Label Content="Статус" Target="{Binding ElementName=StateFilter}"/><ComboBox x:Name="StateFilter" SelectionChanged="Filter_Changed"/></StackPanel>
                <StackPanel Width="155" Margin="0,0,8,4"><Label Content="Дата" Target="{Binding ElementName=DateFilter}"/><ComboBox x:Name="DateFilter" SelectionChanged="Filter_Changed"/></StackPanel>
                <StackPanel Width="140" Margin="0,0,8,4"><Label Content="Зал" Target="{Binding ElementName=RoomFilter}"/><ComboBox x:Name="RoomFilter" DisplayMemberPath="Text" SelectionChanged="Filter_Changed"/></StackPanel>
                <StackPanel Width="156" Margin="0,0,8,4"><Label Content="Фотограф" Target="{Binding ElementName=PhotoFilter}"/><ComboBox x:Name="PhotoFilter" DisplayMemberPath="Text" SelectionChanged="Filter_Changed"/></StackPanel>
                <StackPanel Width="130" Margin="0,0,8,4"><Label Content="Реквизит" Target="{Binding ElementName=PropFilter}"/><ComboBox x:Name="PropFilter" SelectionChanged="Filter_Changed"/></StackPanel>
                <Button Content="Сбросить фильтры" Click="Reset_Click" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
            </WrapPanel>
            <StackPanel x:Name="AmountFilters" Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,9">
                <Label Content="Сумма от" Target="{Binding ElementName=MinBox}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="MinBox" Width="100" MaxLength="16" TextChanged="Filter_Changed"/>
                <Label Content="до" Target="{Binding ElementName=MaxBox}" VerticalAlignment="Center" Margin="8,0,6,0"/>
                <TextBox x:Name="MaxBox" Width="100" MaxLength="16" TextChanged="Filter_Changed"/>
                <TextBlock x:Name="FilterError" Foreground="#A1263D" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
            <Border Grid.Row="4" CornerRadius="7" BorderThickness="1" BorderBrush="{StaticResource Line}" Background="White" ClipToBounds="True">
                <Grid>
                    <DataGrid x:Name="BookingsGrid" SelectionChanged="Selection_Changed">
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,6" Background="#F1EAF8">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Conflict}" Value="True">
                                        <Setter Property="Background" Value="#FDE5E9"/>
                                        <Setter Property="Foreground" Value="#9B2942"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Бронь" Binding="{Binding Number}" Width="85" SortMemberPath="Id"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Start, StringFormat=dd.MM.yyyy}" Width="105" SortMemberPath="Start"/>
                            <DataGridTextColumn Header="Время" Binding="{Binding Time}" Width="111" SortMemberPath="Start"/>
                            <DataGridTextColumn Header="Клиент" Binding="{Binding Client}" Width="*" MinWidth="128"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="115"/>
                            <DataGridTextColumn Header="Часы" Binding="{Binding Hours, StringFormat=0.##}" Width="63"/>
                            <DataGridTextColumn Header="Фотограф" Binding="{Binding Photographer}" Width="*" MinWidth="135"/>
                            <DataGridTemplateColumn Header="Статус" Width="154" SortMemberPath="Priority">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="7,3" CornerRadius="4" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F0E8F5"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="Confirmed"><Setter Property="Background" Value="#D9F2DF"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Paid">
                                                            <Setter Property="Background" Value="#236044"/>
                                                            <Setter Property="TextElement.Foreground" Value="White"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="InWork"><Setter Property="Background" Value="#FFEDAD"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Cancelled"><Setter Property="Background" Value="#E8E8EC"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="TotalColumn" Header="Сумма, ₽" Binding="{Binding Total, StringFormat=N2}" Width="105"/>
                            <DataGridTextColumn x:Name="AdvanceColumn" Header="Предоплата, ₽" Binding="{Binding Advance, StringFormat=N2}" Width="116"/>
                            <DataGridTextColumn Header="Реквизит" Binding="{Binding PropStatus}" Width="119"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="Empty" Text="Брони по выбранным условиям не найдены." Visibility="Collapsed"
                               IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <DockPanel Grid.Row="5" Margin="0,10,0,0">
                <TextBlock x:Name="Counter" Foreground="{StaticResource Muted}" FontSize="12"/>
                <TextBlock x:Name="Status" Foreground="{StaticResource Muted}" FontSize="12" Margin="12,0"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
